{
  // https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  // https://docs.renovatebot.com/modules/manager/nix/
  "nix": {
    "enabled": true
  },
  // https://docs.renovatebot.com/updating-rebasing/
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      // Group all digest updates into a single PR
      "groupName": "Digest Updates",
      "groupSlug": "all-digest",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      // Automerge dev dependencies
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    },
    {
      // Automerge non-breaking changes
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}